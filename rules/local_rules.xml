<!--
  Home SOC Lab - custom Wazuh detection & tuning rules
  Author: Vivek Sharma
  Wazuh version: 4.14.9
  Install: /var/ossec/etc/rules/local_rules.xml
  Test:    sudo /var/ossec/bin/wazuh-analysisd -t && sudo systemctl restart wazuh-manager

  NOTE: Windows eventchannel paths are stored with escaped backslashes
  (C:\\Windows\\...), so path regexes below use \\\\ to match ONE literal "\\" pair.
-->

<!-- ============================================================
     ATTACK 1 - Port scan (MITRE T1046)
     Requires on Windows:
       auditpol /set /subcategory:"Filtering Platform Packet Drop" /failure:enable
       auditpol /set /subcategory:"Filtering Platform Connection" /failure:enable
     and Event 5152/5157 removed from the agent's Security query filter.
     ============================================================ -->
<group name="local,windows,portscan,">

  <!-- Inbound TCP connection blocked by Windows Firewall, to a service port (<49152) -->
  <rule id="100100" level="3">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^5152$|^5157$</field>
    <field name="win.eventdata.protocol">^6$</field>
    <field name="win.eventdata.direction">^%%14592$</field>
    <field name="win.eventdata.destPort" type="pcre2" negate="yes">^(49(1(5[2-9]|[6-9][0-9])|[2-9][0-9]{2})|5[0-9]{4}|6([0-4][0-9]{3}|5([0-4][0-9]{2}|5([0-2][0-9]|3[0-5]))))$</field>
    <description>Windows Firewall blocked TCP connection from $(win.eventdata.sourceAddress) to port $(win.eventdata.destPort)</description>
  </rule>

  <!-- Correlation: 20+ blocked inbound connections from the same IP in 30s = port scan -->
  <rule id="100101" level="10" frequency="20" timeframe="30">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>win.eventdata.sourceAddress</same_field>
    <description>Possible port scan: 20+ blocked connections from $(win.eventdata.sourceAddress) in 30 seconds</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>

<!-- ============================================================
     ATTACK 2 - Successful brute force (MITRE T1110)
     Wazuh detects failed brute force by default, but NOT a successful one.
     ============================================================ -->
<group name="local,windows,bruteforce,">
  <rule id="100110" level="12" timeframe="300">
    <if_group>authentication_success</if_group>
    <if_matched_group>authentication_failures</if_matched_group>
    <same_field>win.eventdata.ipAddress</same_field>
    <!-- FP tuning: NetExec's anonymous null session is not a compromise -->
    <field name="win.eventdata.targetUserName" negate="yes">^ANONYMOUS LOGON$</field>
    <description>Brute force SUCCEEDED: $(win.eventdata.targetUserName) logged in from $(win.eventdata.ipAddress) after multiple failures</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>

<!-- ============================================================
     ATTACK 3 - Scheduled task persistence (MITRE T1053.005)
     Catches the Register-ScheduledTask technique that bypassed Microsoft Defender.
     Requires on Windows:
       auditpol /set /subcategory:"Other Object Access Events" /success:enable   (Event 4698)
     ============================================================ -->
<group name="local,windows,persistence,">

  <!-- Baseline visibility: any new scheduled task -->
  <rule id="100119" level="5">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4698$</field>
    <description>Scheduled task created: $(win.eventdata.taskName) by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Escalate: task launches a script interpreter / LOLBin -->
  <rule id="100120" level="12">
    <if_sid>100119</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)powershell|pwsh|cmd\.exe|wscript|cscript|mshta|rundll32</field>
    <description>Suspicious scheduled task $(win.eventdata.taskName) launches a script interpreter (possible persistence)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>
</group>

<!-- ============================================================
     TUNING - suppress verified benign noise (level 0 = no alert)
     Each rule matches ONLY the exact benign pattern, validated with
     a benign test (silenced) and a malicious test (still alerts).
     ============================================================ -->
<group name="local,tuning,">

  <!-- T1: non-TCP packet drops (broadcast / multicast / link-local noise from WFP auditing) -->
  <rule id="100200" level="0">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^5152$|^5157$</field>
    <field name="win.eventdata.protocol" negate="yes">^6$</field>
    <description>Tuning: ignore non-TCP Windows Filtering Platform drops</description>
  </rule>

  <!-- T2: PowerShell's own execution-policy test script (was a level 15 false positive) -->
  <rule id="100201" level="0">
    <if_sid>92205, 92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\WindowsPowerShell\\\\v1\.0\\\\powershell\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\\\__PSScriptPolicyTest_[a-z0-9]+\.[a-z0-9]+\.ps1$</field>
    <description>Tuning: PowerShell execution-policy test script (benign)</description>
  </rule>

  <!-- T3: per-user service instances Windows creates at every logon (e.g. WpnUserService_517c0) -->
  <rule id="100202" level="0">
    <if_sid>92307</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\system32\\\\services\.exe$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\\\Services\\\\[a-z0-9]+_[0-9a-f]{4,6}\\\\ImagePath$</field>
    <description>Tuning: Windows per-user service instance (benign)</description>
  </rule>

  <!-- T4: Microsoft Defender signature updates / Security Health setup -->
  <rule id="100203" level="0">
    <if_sid>92217</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)(\\\\SystemTemp\\\\[0-9a-f-]+MpCommU\\\\mpam-[a-z0-9_.-]+\.exe|\\\\System32\\\\SecurityHealth\\\\SecurityHealthSetup\.exe)$</field>
    <description>Tuning: Defender / Security Health update (benign)</description>
  </rule>

  <!-- T5: outbound TCP drops (victim's own traffic, not an attack against it) -->
  <rule id="100204" level="0">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^5152$|^5157$</field>
    <field name="win.eventdata.direction">^%%14593$</field>
    <description>Tuning: ignore outbound WFP drops</description>
  </rule>

  <!-- T6: inbound drops to ephemeral ports 49152-65535 (late replies to the victim's own connections) -->
  <rule id="100205" level="0">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^5152$|^5157$</field>
    <field name="win.eventdata.direction">^%%14592$</field>
    <field name="win.eventdata.destPort" type="pcre2">^(49(1(5[2-9]|[6-9][0-9])|[2-9][0-9]{2})|5[0-9]{4}|6([0-4][0-9]{3}|5([0-4][0-9]{2}|5([0-2][0-9]|3[0-5]))))$</field>
    <description>Tuning: ignore inbound WFP drops to ephemeral ports</description>
  </rule>
</group>
